# Room settings
#
# ROOM_NAME: Display name of the room in the public list
# ADMIN_PASSWORD: Password used with !admin to become room admin
# ROOM_PASSWORD: Password required to join the room (empty = no password)
# MAX_PLAYERS: Maximum number of players allowed in the room
# SHOW_IN_ROOM_LIST: Whether the room appears in the public room list (true/false)
# NO_PLAYER: Run as headless host without joining as a player (true/false)
#
# Host identity
#
# HOST_NAME: Name of the host player when NO_PLAYER is false
# HOST_AVATAR: Avatar of the host player when NO_PLAYER is false
#
# Maps
#
# SMALL_MAP_FILE: Stadium used for 1vs1–3vs3 (inside maps/)
# BIG_MAP_FILE: Stadium used for 4vs4–5vs5 (inside maps/)
#
# Geolocation (used for room list distance / flag)
#
# GEO_LAT: Latitude of the room location
# GEO_LON: Longitude of the room location
# GEO_FLAG: 2-letter country code shown in the room list (e.g. es, en, br)
#
# Localization
#
# LANGUAGE: Server language code (es or en). Defaults to es
#
# Headless token
#
# TOKEN_URL: URL where a headless token can be obtained
# TOKEN: Headless token (preferred). If empty, the server asks for it on startup
# HAXBALL_TOKEN: Alternative name for TOKEN (used if TOKEN is empty)
#
ROOM_NAME=Tikitaka
ADMIN_PASSWORD=admin
ROOM_PASSWORD=
MAX_PLAYERS=16
SHOW_IN_ROOM_LIST=true
NO_PLAYER=true
HOST_NAME=Tikitaka
HOST_AVATAR=⚽
SMALL_MAP_FILE=small-map.json
BIG_MAP_FILE=big-map.json
GEO_LAT=40.4168
GEO_LON=-3.7038
GEO_FLAG=es
LANGUAGE=es
TOKEN_URL=https://www.haxball.com/headlesstoken
TOKEN=
HAXBALL_TOKEN=
