# Room settings
#
# ROOM_NAME: Display name of the room in the public list
# ADMIN_PASSWORD: Password used with !admin to become room admin
# SUBADMIN_PASSWORD: Password used with !subadmin to become a hidden
#                    sub-admin (can use !kick / !mute without room admin)
# ROOM_PASSWORD: Password required to join the room (empty = no password)
# MAX_PLAYERS: Maximum number of players allowed in the room
# SHOW_IN_ROOM_LIST: Whether the room appears in the public room list (true/false)
# NO_PLAYER: Run as headless host without joining as a player (true/false)
#
# Match
#
# FILL_MODE: How players enter the field (pairs or instant)
#   instant: players enter the field as soon as they connect, up to the
#            per-team cap; teams are kept balanced (difference of at most 1)
#            and are compensated when players leave (default)
#   pairs: wait for an even number of players so teams are always NvsN;
#          the odd player waits as spectator with a notice
# MAX_TEAM_SIZE: Maximum players per team on the field (e.g. 6 = up to 6vs6)
# MAP_SWITCH_TO_BIG_PLAYERS: Non-AFK connected players needed to use BIG_MAP_FILE
#                            (default 8, i.e. 4vs4 real). Rechecked on every goal.
# MAP_SWITCH_TO_SMALL_MAX_PLAYERS: If non-AFK connected players are this number
#                                  or less, use SMALL_MAP_FILE (default 6).
#                                  Between this and MAP_SWITCH_TO_BIG_PLAYERS
#                                  the room keeps the current map (hysteresis).
#                                  Rechecked on every goal.
# AFK_TIMEOUT_MS: Milliseconds without movement, input or typing before kicking
#                 an on-field player during live play (default 10000). Not
#                 checked during kickoff, after goals, victory screen, or pause.
#                 At half that time the player gets a private countdown warning.
#
# Host identity
#
# HOST_NAME: Name of the host player when NO_PLAYER is false
# HOST_AVATAR: Avatar of the host player when NO_PLAYER is false
#
# Maps
#
# SMALL_MAP_FILE: Stadium used for 1vs1–3vs3 (inside maps/)
# BIG_MAP_FILE: Stadium used from 4vs4 up to MAX_TEAM_SIZE (inside maps/)
# SMALL_MAP_TIME_LIMIT: Match time limit in minutes for the small map
#                       (default 3). 0 = unlimited. Range 0–99.
# BIG_MAP_TIME_LIMIT: Match time limit in minutes for the big map
#                     (default 5). 0 = unlimited. Range 0–99.
# SMALL_MAP_SCORE_LIMIT: Goals needed to win on the small map
#                        (default 3). 0 = unlimited. Range 0–99.
# BIG_MAP_SCORE_LIMIT: Goals needed to win on the big map
#                      (default 3). 0 = unlimited. Range 0–99.
#
# Geolocation (used for room list distance / flag)
#
# GEO_LAT: Latitude of the room location
# GEO_LON: Longitude of the room location
# GEO_FLAG: 2-letter country code shown in the room list (e.g. es, en, br)
#
# Localization
#
# LANGUAGE: Server language code (es or en). Defaults to es
#
# Headless token
#
# TOKEN_URL: URL where a headless token can be obtained
# TOKEN: Headless token (preferred). If empty, the server asks for it on startup
# HAXBALL_TOKEN: Alternative name for TOKEN (used if TOKEN is empty)
#
# Discord
#
# DISCORD_BOT_TOKEN: Discord bot token. If set, the bot connects and shows the
#                    current player count as its status ("Playing X/MAX_PLAYERS").
#                    Empty = Discord bot disabled
# DISCORD_CHAT_CHANNEL_ID: Discord text channel id where public HaxBall chat is
#                          mirrored (requires DISCORD_BOT_TOKEN). Empty = off
# DISCORD_LOGS_CHANNEL_ID: Discord text channel id for application logs
#                          (requires DISCORD_BOT_TOKEN). Empty = off
#
ROOM_NAME=Tikitaka
ADMIN_PASSWORD=admin
SUBADMIN_PASSWORD=subadmin
ROOM_PASSWORD=
MAX_PLAYERS=16
MAX_TEAM_SIZE=6
MAP_SWITCH_TO_BIG_PLAYERS=8
MAP_SWITCH_TO_SMALL_MAX_PLAYERS=6
FILL_MODE=instant
AFK_TIMEOUT_MS=10000
SHOW_IN_ROOM_LIST=true
NO_PLAYER=true
HOST_NAME=Tikitaka
HOST_AVATAR=⚽
SMALL_MAP_FILE=small-map.json
BIG_MAP_FILE=big-map.json
SMALL_MAP_TIME_LIMIT=3
BIG_MAP_TIME_LIMIT=5
SMALL_MAP_SCORE_LIMIT=3
BIG_MAP_SCORE_LIMIT=3
GEO_LAT=40.4168
GEO_LON=-3.7038
GEO_FLAG=es
LANGUAGE=es
DISCORD_BOT_TOKEN=
DISCORD_CHAT_CHANNEL_ID=
DISCORD_LOGS_CHANNEL_ID=
TOKEN_URL=https://www.haxball.com/headlesstoken
TOKEN=
HAXBALL_TOKEN=
